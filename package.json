{
  "name": "school-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node -e \"const fs=require('node:fs'); for (const path of ['.next/types','.next/dev/types','tsconfig.tsbuildinfo']) fs.rmSync(path,{recursive:true,force:true});\" && npx next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run lib/__tests__/**/*.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm run build",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "postdeploy:smoke": "node scripts/postdeploy-smoke.mjs",
    "postdeploy:login-rate-limit": "node scripts/postdeploy-login-rate-limit.mjs",
    "deploy:direct": "bash scripts/direct-deploy.sh",
    "audit:prod": "npm audit --omit=dev",
    "seed:users": "node scripts/create-default-users.mjs",
    "qa:seed:e2e": "npx tsx scripts/qa-seed-e2e-accounts.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.48.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.3"
  }
}
