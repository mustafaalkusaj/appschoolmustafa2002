# ─── White-Label Brand Configuration ─────────────────────────────────
# Copy this file to .env.local and fill in values for your site.
# Any empty or missing value falls back to the default (School Iraq / blue).

# ─── Site Name ───────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME_AR=<اسم المدرسة>
NEXT_PUBLIC_BRAND_NAME_EN=<School Name>
NEXT_PUBLIC_BRAND_SUBTITLE_AR=<الاسم الكامل>
NEXT_PUBLIC_BRAND_SUBTITLE_EN=<Full School Name>

# ─── Theme Preset ────────────────────────────────────────────────────
# Pick one from lib/brand/themes.ts (e.g. green-growth, blue-academic,
# emerald-nature, warm-desert, purple-royal, etc.)
NEXT_PUBLIC_BRAND_THEME=green-growth

# ─── Logo ────────────────────────────────────────────────────────────
# URL to the school logo (absolute or relative to /public)
NEXT_PUBLIC_BRAND_LOGO_URL=/images/school-logo.png

# ─── Feature Flags ───────────────────────────────────────────────────
# Comma-separated list of features to enable on this site.
# Example: transport,ads,behavior_points
NEXT_PUBLIC_FEATURES=
