NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3001
APP_URL=https://school-iraq.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
JWT_SECRET=

# RBAC and health checks
RBAC_COOKIE_SECRET=<run: openssl rand -base64 48>
SESSION_COOKIE_SECURE=true
HEALTHCHECK_TOKEN=<run: openssl rand -base64 32>

# Recommended for production
NEXT_PUBLIC_SENTRY_DSN=

# Required for production Redis-backed rate limiting.
# This host does not use Upstash cloud: it runs redis-server on loopback with a
# serverless-redis-http (SRH) container in front, which speaks the same REST
# protocol the @upstash/redis client expects. See docs/RATE_LIMIT_REDIS.md.
# Leaving these empty is not harmless — the limiter silently drops to an
# in-process token bucket that resets on every restart.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=<contents of /etc/redis/srh-token on the app host>

# Ops / WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE=
WHATSAPP_TEMPLATE_NAME=
OPS_ALERT_TOKEN=
OPS_REPORT_CRON_SECRET=
OPS_WHATSAPP_ENABLED=
OPS_DAILY_REPORT_ENABLED=

# Ops / Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_TELEGRAM_ENABLED=
# Telegram Bot Commands webhook secret (run: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# Ops / Email (Resend)
RESEND_API_KEY=
OPS_ALERT_EMAIL_FROM=
OPS_ALERT_EMAIL_TO=
OPS_EMAIL_ENABLED=
